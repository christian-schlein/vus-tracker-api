APP_NAME="VUS Tracker API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vus.zyrkel.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vus_tracker
DB_USERNAME=vus_tracker_user
DB_PASSWORD=

# API Keys — both required for any access
# Read key: embedded in frontend JS, allows GET endpoints
# Write key: only for GH Actions import pipeline, allows POST endpoints
VUS_READ_API_KEY=
VUS_IMPORT_API_KEY=

CORS_ALLOWED_ORIGINS=https://schlein-lab.github.io
